        print("Расход добавлен!")

    elif choice == "2":
        if len(expenses) == 0:
            print("Расходов пока нет.")
        else:
            print("\n--- ВСЕ РАСХОДЫ ---")
            for category in expenses:
                print(category, ":", expenses[category])

    elif choice == "3":
        if len(expenses) == 0:
            print("Данных для статистики нет.")
        else:
            print("\n--- СТАТИСТИКА ---")
            total = 0
            for category in expenses:
                category_sum = sum(expenses[category])
                total = total + category_sum
                print(f"Категория {category}: потрачено {category_sum}")
            print(f"Общий итог: {total}")

    elif choice == "4":
        print("Выход из программы.")
        break  # Останавливает главный цикл while

    else:
        print("Неверный пункт меню, попробуйте еще раз.")

