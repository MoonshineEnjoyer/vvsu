        for j in range(0, n - i - 1):
            if arr[j] > arr[j + 1]:
                arr[j], arr[j + 1] = arr[j + 1], arr[j]

# Версия Б: С флагом раннего выхода (оптимизированная)
def bubble_sort_flag(arr):
    n = len(arr)
    for i in range(n):
        swapped = False
        for j in range(0, n - i - 1):
            if arr[j] > arr[j + 1]:
                arr[j], arr[j + 1] = arr[j + 1], arr[j]
                swapped = True
        # Если ни одного обмена не произошло, массив уже отсортирован
        if not swapped:
            break

# Версия В: С ограничением границы последнего обмена
def bubble_sort_boundary(arr):
    n = len(arr)
    while n > 1:
        new_n = 0
        for j in range(0, n - 1):
            if arr[j] > arr[j + 1]:
                arr[j], arr[j + 1] = arr[j + 1], arr[j]
                new_n = j + 1  # Запоминаем индекс последнего обмена
        n = new_n  # Все элементы после new_n уже стоят на своих местах


