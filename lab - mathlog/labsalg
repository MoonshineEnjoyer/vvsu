# Создаём узел
class Node:
    def __init__(self, value):
        self.value = value
        self.next = None

# Создание стека (связной список, LIFO)
class Stack:
    def __init__(self):
        self.top = None
        self._size = 0

    def push(self, value):
        new_node = Node(value)
        new_node.next = self.top
        self.top = new_node
        self._size += 1

    def pop(self):
        if self.is_empty():
            raise IndexError("Pop из пустого стека")
        val = self.top.value
        self.top = self.top.next
        self._size -= 1
        return val

    def peek(self):
        return self.top.value if self.top else None

    def is_empty(self):
        return self.top is None

# Очередь, связной список LIFO O(1)
class Queue:
    def __init__(self):
        self.head = None
        self.tail = None
        self._size = 0

    def enqueue(self, value):
        new_node = Node(value)
        if self.tail:
            self.tail.next = new_node
        self.tail = new_node
        if not self.head:
            self.head = new_node
        self._size += 1

    def dequeue(self):
        if self.is_empty():
            raise IndexError("Dequeue из пустой очереди")
        val = self.head.value
        self.head = self.head.next
        if not self.head:
            self.tail = None
        self._size -= 1
        return val

    def is_empty(self):
        return self.head is None

class LinkedListCalculator:
    def __init__(self):
        self.ops = {
            '+': (1, 'L'), '-': (1, 'L'), # Сложение
            '*': (2, 'L'), '/': (2, 'L'), # Умножение
            '**': (3, 'R'), # Возведение в степень
            'u-': (4, 'R')  # Унарный минус
        }
        self.funcs = {'sin', 'cos', 'tg', 'ctg', 'sqrt'}

    def _tokenize(self, expr):
        tokens = Queue()
        expr = expr.replace(' ', '').replace(',', '.')
        i = 0
        prev_token = None
        while i < len(expr):
            char = expr[i]
            # Проверка ввода чисел
            if char.isdigit() or char == '.':
                num = ""
                while i < len(expr) and (expr[i].isdigit() or expr[i] == '.'):
                    num += expr[i]
                    i += 1
                tokens.enqueue(num)
                prev_token = num
                continue
            if char == '-':
                if prev_token is None or prev_token == '(' or prev_token in self.ops:
                    token = 'u-'
                else:
                    token = '-'
                tokens.enqueue(token)
                prev_token = token
                i += 1
            # Проверка ввода букв (т.е. функций)
            elif char.isalpha():
                fn = ""
                while i < len(expr) and expr[i].isalpha():
                    fn += expr[i]
                    i += 1
                tokens.enqueue(fn)
                prev_token = fn
            # Проверка на возведение в степень
            elif char == '*' and i + 1 < len(expr) and expr[i+1] == '*':
                tokens.enqueue('**')
                i += 2
            # Остальные символы (+, -, *, /, (, ))
            else:
                tokens.enqueue(char)
                prev_token = char
                i += 1
        return tokens

    def to_postfix(self, expression):
        tokens = self._tokenize(expression)
        output = Queue()
        stack = Stack()

        while not tokens.is_empty():
            t = tokens.dequeue()
            if t[0].isdigit() or (len(t) > 1 and t[1].isdigit()):
                output.enqueue(t)
            elif t in self.funcs:
                stack.push(t)
            elif t == '(':
                stack.push(t)
            elif t == ')':
                while not stack.is_empty() and stack.peek() != '(':
                    output.enqueue(stack.pop())
                stack.pop() # убираем '('
                if not stack.is_empty() and stack.peek() in self.funcs:
                    output.enqueue(stack.pop())
            elif t in self.ops:
                p1, a1 = self.ops[t]
                while not stack.is_empty() and stack.peek() in self.ops:
                    p2, _ = self.ops[stack.peek()]
                    if (a1 == 'L' and p1 <= p2) or (a1 == 'R' and p1 < p2):
                        output.enqueue(stack.pop())
                    else: break
                stack.push(t)

        while not stack.is_empty():
            output.enqueue(stack.pop())

        res_str=""
        while not output.is_empty():
            res_str += output.dequeue() + " "
        return res_str.strip()

    def calculate(self, expression):
        postfix = self.to_postfix(expression).split()
        stack = Stack()

        for t in postfix:
            # Унарный минус
            if t == 'u-':
                a = stack.pop()
                stack.push(-a)
            # Число => float => помещаем в стек
            elif t[0].isdigit() or '.' in t:
                stack.push(float(t))
            elif t in self.ops:
                b, a = stack.pop(), stack.pop()
                if t == '+': stack.push(a + b)
                elif t == '-': stack.push(a - b)
                elif t == '*': stack.push(a * b)
                elif t == '/': stack.push(a / b)
                elif t == '**': stack.push(a ** b)
            elif t in self.funcs:
                a = stack.pop()
                if t == 'sin': stack.push(math.sin(math.radians(a)))
                elif t == 'cos': stack.push(math.cos(math.radians(a)))
                elif t == 'tg': stack.push(math.tan(math.radians(a)))
                elif t == 'ctg': stack.push(1 / math.tan(math.radians(a)))
                elif t == 'sqrt': stack.push(math.sqrt(a))
        return stack.pop()


def run_benchmark(): # сравнение производительности стека и очереди
    n = 10000
    s = Stack()
    q = Queue()

    t_push = timeit.timeit(lambda: [s.push(i) for i in range(n)], number=1)
    t_pop = timeit.timeit(lambda: [s.pop() for _ in range(n)], number=1)
    t_enq = timeit.timeit(lambda: [q.enqueue(i) for i in range(n)], number=1)
    t_deq = timeit.timeit(lambda: [q.dequeue() for _ in range(n)], number=1)

    print(f"Количество операций ({n} операций):")
    print(f"Stack Push/Pop:   {t_push:.5f}s / {t_pop:.5f}s")
    print(f"Queue Enq/Deq:    {t_enq:.5f}s / {t_deq:.5f}s")

