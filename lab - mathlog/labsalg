# Класс одного узла списка
class Node:
    def __init__(self, data):
        self.data = data  # Хранит данные
        self.next = None  # Ссылка на следующий узел

# Класс связного списка
class LinkedList:
    def __init__(self):
        self.head = None  # Голова списка (первый элемент)

    # --- МЕТОДЫ ИЗ ЗАДАНИЯ №1 ---

    # Вставка в начало списка
    def add_first(self, data):
        new_node = Node(data)
        new_node.next = self.head
        self.head = new_node

    # Печать всех элементов в формате 10 -> 20 -> 30 -> None
    def print_list(self):
        current = self.head
        elements = []
        while current:
            elements.append(str(current.data))
            current = current.next
        elements.append("None")
        print(" -> ".join(elements))

    # Возврат количества элементов в списке
    def length(self):
        count = 0
        current = self.head
        while current:
            count += 1
            current = current.next
        return count

    # Поиск позиции элемента (индекс от 0, или -1 если не найден)
    def search(self, target):
        current = self.head
        index = 0
        while current:
            if current.data == target:
                return index
            current = current.next
            index += 1
        return -1


    # --- МЕТОДЫ ИЗ ЗАДАНИЯ №2 ---

    # Вставка в конец списка
    def add_last(self, data):
        new_node = Node(data)
        if not self.head:
            self.head = new_node
            return
        
        current = self.head
        while current.next:
            current = current.next
        current.next = new_node

    # Вставка элемента на позицию position (0-based)
    def insert_at(self, position, data):
        if position < 0:
            raise ValueError("Позиция не может быть отрицательной")
            
        if position == 0:
            self.add_first(data)
            return

        new_node = Node(data)
        current = self.head
        index = 0

        # Ищем элемент, ПЕРЕД которым нужно вставить новый узел
        while current and index < position - 1:
            current = current.next
            index += 1

        # Если позиция > длины списка или мы дошли до конца — вставляем в самый конец
        if not current or current.next is None:
            self.add_last(data)
        else:
            new_node.next = current.next
            current.next = new_node

    # Удаление первого узла с указанным значением
    def remove(self, data):
        if not self.head:
            return False

        # Если удаляемый элемент находится в голове списка
        if self.head.data == data:
            self.head = self.head.next
            return True

        current = self.head
        while current.next:
            if current.next.data == data:
                current.next = current.next.next
                return True
            current = current.next
            
        return False

    # Возврат содержимого в виде обычного Python-списка
    def to_list(self):
        current = self.head
        result = []
        while current:
            result.append(current.data)
            current = current.next
        return result


