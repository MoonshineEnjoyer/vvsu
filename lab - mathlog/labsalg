class Node:
    def __init__(self, key):
        self.left = None
        self.right = None
        self.val = key

def height(node):
    if node is None:
        return 0
    return max(height(node.left), height(node.right)) + 1

def insert(root, key):
    if root is None:
        return Node(key)
    if key < root.val:
        root.left = insert(root.left, key)
    else:
        root.right = insert(root.right, key)
    return root

def search_with_steps(node, key, steps=0):
    if node is None:
        return False, steps
    steps += 1
    if node.val == key:
        return True, steps
    if key > node.val:
        return search_with_steps(node.right, key, steps)
    return search_with_steps(node.left, key, steps)

def print_tree(node, level=0, prefix="Root: "):
    if node is not None:
        print("    " * level + prefix + str(node.val))
        if node.left or node.right:
            print_tree(node.left, level + 1, "L: ")
            print_tree(node.right, level + 1, "R: ")

